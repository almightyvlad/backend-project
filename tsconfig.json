{
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "resolvePackageJsonExports": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2023",
    "sourceMap": true,
    "outDir": "./dist",
    "incremental": true,
    "skipLibCheck": true,
    "strict": true,
    "strictPropertyInitialization": false,
    "types": ["vitest/globals", "node", "multer"],
    "paths": {
      "@app/common": ["./libs/common/src/index.ts"],
      "@app/common/*": ["./libs/common/src/*"]
    }
  },
  "files": [],
  "references": [
    {
      "path": "./apps/user-service/tsconfig.app.json"
    },
    {
      "path": "./apps/notification-service/tsconfig.app.json"
    },
    {
      "path": "./libs/common/tsconfig.lib.json"
    },
    {
      "path": "./libs/common/tsconfig.spec.json"
    },
    {
      "path": "./apps/user-service/tsconfig.spec.json"
    },
    {
      "path": "./apps/notification-service/tsconfig.spec.json"
    }
  ]
}
